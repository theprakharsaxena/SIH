# Copy this to .env and fill in your values
# Never commit .env to git

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://sih:sih_secret@localhost:5432/skill_intelligence

# ── Adapter selection ──────────────────────────────────────
# Options: 'mock' | 'igot'
COURSE_CATALOG_PROVIDER=mock

# Options: 'mock' | 'nssta'
TRAINING_CALENDAR_PROVIDER=mock

# Options: 'mock' | 'parichay_sso'
AUTH_PROVIDER=mock

# Path to mock course catalog JSON
MOCK_CATALOG_PATH=data/mock_course_catalog.json

# ── LLM Provider ───────────────────────────────────────────
# Options: 'openai' | 'google'
LLM_PROVIDER=novita
NOVITA_API_KEY=your_novita_key_here

# Model for text generation (profile extraction + MCQ)
NOVITA_MODEL=deepseek/deepseek-v4-flash
# Novita's OpenAI-compatible base URL
NOVITA_BASE_URL=https://api.novita.ai/v3/openai
# Embedding model (for pgvector course matching)
NOVITA_EMBEDDING_MODEL=baai/bge-m3

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini (if LLM_PROVIDER=google)
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-1.5-flash

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── File storage ───────────────────────────────────────────
# For uploaded PDFs (MCQ engine)
UPLOAD_DIR=data/uploads
